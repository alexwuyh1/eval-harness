{
  "name": "view",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun run server.ts\" \"vite\"",
    "dev:bg": "tmux new -d -s my-agent-view 'bun run dev'",
    "dev:stop": "tmux kill-session -t my-agent-view 2>/dev/null || true",
    "dev:attach": "tmux attach -t my-agent-view",
    "build": "vite build",
    "server": "bun run server.ts"
  },
  "dependencies": {
    "preact": "^10.25.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
    "@types/bun": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.9.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "unocss": "^0.65.1",
    "vite": "^6.0.5"
  }
}
